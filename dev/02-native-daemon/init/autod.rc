# autod 的 init 服务定义
#
# 安装位置：/system/etc/init/autod.rc
# Android.bp 里的 `init_rc: ["../init/autod.rc"]` 会自动装过去。
#
# 用 init 创建 socket 的好处：
#   1. init 会自动给 socket 打上正确的 SELinux 标签（autod_socket）
#   2. 不需要 daemon 自己 chmod/chown
#   3. daemon 通过 ANDROID_SOCKET_autod 环境变量拿到已 listen 的 fd
#   4. 服务崩溃重启时 socket 不会丢

service autod /system/bin/autod --init-socket autod
    class core
    user system
    group system graphics input

    # 独立 SELinux domain。没有这一行 init 会拒绝启动。
    seclabel u:r:autod:s0

    # init 创建 /dev/socket/autod，并把 fd 通过 ANDROID_SOCKET_autod 传下去。
    # 0660 + system:system 意味着只有 system UID 和 system 组能连。
    socket autod seqpacket 0660 system system

    # 关键：autod 会调 system_server（InputManagerService）和
    # surfaceflinger，属于 core 服务，要等它们起来。
    # 用 late_start 更稳，避免在 system_server 就绪前失败。
    # 注意 class 要相应改成 late_start。

    # 崩溃自动重启，但限制频率避免 boot loop
    oneshot
    disabled

# autod 真正需要启动时，用这个触发
on property:sys.boot_completed=1
    start autod

# ---------------------------------------------------------------------------
# 调试用：跳过 seclabel 和 socket，以 root 身份前台跑
# （阶段 1 原型验证用，不要进生产镜像）
# ---------------------------------------------------------------------------
#
# service autod_debug /system/bin/autod --socket /data/local/tmp/autod.sock --foreground
#     class main
#     user root
#     group root system
#     oneshot
#     disabled
#
# 然后：adb shell start autod_debug
#       或直接 adb shell /system/bin/autod --socket /data/local/tmp/autod.sock
