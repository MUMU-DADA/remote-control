// rcctl（参考客户端）的构建描述
//
// 放置位置：frameworks/native/cmds/remote-control/client/Android.bp
// 编译：m rcctl

cc_binary {
    name: "rcctl",
    srcs: ["rcctl.cpp"],

    shared_libs: [
        "libbase",
        "liblog",

        // AndroidBitmap_compress 的**实现**在这里（链接期），不是 libandroid。
        "libjnigraphics",
    ],

    // 编译期还需要 jni.h 与 ADataSpace：
    //   <android/bitmap.h>   里 #include <jni.h>       → jni_headers
    //   <android/data_space.h>（ADATASPACE_SRGB）      → libnativewindow_headers
    //
    // ⚠️ libjnigraphics 帮不上忙：它自己用的是 header_libs（只作用于自己），
    //    **没有** export_header_lib_headers，所以这两个头都不会传给链接它的模块。
    //    漏掉的报错是 "fatal error: 'jni.h' / 'android/data_space.h' file not found"，
    //    跟库名八竿子打不着，很难猜（实测两个都踩过）。
    //
    //    官方写法对照：frameworks/base/cmds/bootanimation/Android.bp
    //      header_libs: ["jni_headers"],
    header_libs: [
        "jni_headers",
        "libnativewindow_headers",
    ],

    // rcctl.cpp 里 #include "../daemon/protocol.h"，
    // 所以 client/ 和 daemon/ 必须保持同级目录。
    // 注意这只影响 #include 解析，Soong 的 srcs/init_rc 不允许 ".."。

    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
    ],

    cppflags: ["-std=c++20"],
    stl: "libc++_static",

    vendor: false,
    proprietary: false,
}
