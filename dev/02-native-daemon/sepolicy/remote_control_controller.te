# =============================================================================
# remote-control 上位应用（com.remotecontrol.controller）的 SELinux 策略
# =============================================================================
#
# 为什么需要单独的域，而不是直接放宽 untrusted_app：
#
#   实测的拒绝是
#     avc: denied { write } for name="remote-control.sock"
#       scontext=u:r:untrusted_app:s0:c105,c256,c512,c768
#       tcontext=u:object_r:shell_data_file:s0
#       tclass=sock_file
#
#   remote-control 的 socket 建在 /data/local/tmp 下，标签是 shell_data_file，
#   而 untrusted_app 访问不了它。
#
#   最省事的做法是加一条
#     allow untrusted_app shell_data_file:sock_file write;
#   但那是**把口子开给所有第三方应用** —— 任何装进来的应用都能控制
#   remote-control（截图、注入触控、装应用、删下载目录里的文件）。绝对不能这么做。
#
#   正确做法：给上位应用一个**专属域**，只允许它访问 remote-control 的 socket。
#   这样即使应用被替换，风险也只限于它自己的域。
#
# ── 接入方式 ──
#
#   1. 把本文件放到 system/sepolicy/private/remote_control_controller.te
#   2. 在 system/sepolicy/private/file_contexts 里给应用打标签：
#        /system/priv-app/RemoteControlController(/.*)?  u:object_r:remote_control_controller_app_data_file:s0
#        /data/user/0/com.remotecontrol.controller(/.*)? u:object_r:remote_control_controller_app_data_file:s0
#        把应用编进 /system/priv-app/
#   3. 在 system/sepolicy/private/seapp_contexts 里把它绑定到专属域：
#        user=system seinfo=platform name=com.remotecontrol.controller domain=remote_control_controller type=privapp_data_file levelFrom=user
#      （或用 seinfo=remote_control_controller 给应用打标记，见下）
#
#   也可以用 tools/integrate-sepolicy.sh 一起接入。
#
# ── 更简单的替代方案 ──
#
#   如果不想为应用单独建域，可以让 remote-control 以 **shell 身份**运行，
#   并把 socket 建在 /data/local/tmp（shell_data_file）：
#     - shell 域本来就能访问 shell_data_file
#     - 应用仍需以 shell 身份运行（`adb shell am start` 启不起来，
#       得让应用进程属于 shell 域）
#   这条只在调试场景可行，不推荐用于产品。
# =============================================================================

# 声明专属域与类型
type remote_control_controller, domain;
type remote_control_controller_app_data_file, file_type, data_file_type, app_use_file_type;

# 应用的基本形态：普通不受信应用
app_domain(remote_control_controller)
appdomain_different_pkg(remote_control_controller)
net_domain(remote_control_controller)
allow remote_control_controller remote_control_controller_app_data_file:dir create_dir_perms;
allow remote_control_controller remote_control_controller_app_data_file:file create_file_perms;

# ── 与 remote-control 的 socket 通信 ──
#
# 需要的是「连接 + 收发」。SOCK_SEQPACKET 在 SELinux 里归在 unix_stream_socket，
# 而 socket 文件本身是 sock_file —— 两类权限都要给。
allow remote_control_controller remote_control_socket:sock_file { read write open getattr };
allow remote_control_controller remote_control_socket:unix_stream_socket { connectto read write };

# 如果 socket 仍在 /data/local/tmp（调试部署），临时用这条：
#   allow remote_control_controller shell_data_file:sock_file { read write open getattr };
# 但它依赖 shell_data_file，产品的正确做法是把 socket 放到专属目录：
#   /data/misc/remote-control/remote-control.sock   u:object_r:remote_control_socket:s0

# ── 让应用能读自己的包信息（应用列表要显示标签/图标）──
allow remote_control_controller remote_control_controller_app_data_file:dir search;
allow remote_control_controller system_file:dir r_dir_perms;

# ⚠️ 不给的东西（刻意为之）：
#   - 不给 untrusted_app 任何新权限
#   - 不给 remote_control_controller 直接写 uinput / 调 SurfaceFlinger / force-stop 应用 ——
#     这些能力都由 remote-control 代劳，应用只是协议的客户端。
#     这样应用被替换时，能做的事不会超过协议暴露的范围。
