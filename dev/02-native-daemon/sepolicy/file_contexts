# remote-control 的 SELinux 文件标签
#
# 安装位置：追加到 system/sepolicy/private/file_contexts
#          （或作为片段加到 sepolicy 的 build 输入里）
#
# 已对照 android-12.0.0_r34 的 private/file_contexts 核实格式：
#   /system/bin/virtual_touchpad     u:object_r:virtual_touchpad_exec:s0
#   /dev/socket/statsdw              u:object_r:statsdw_socket:s0

# 二进制
/system/bin/remote-control u:object_r:remote_control_exec:s0

# 对外 socket
#
# init 在解析 remote-control.rc 的 `socket remote-control seqpacket ...` 时会创建 /dev/socket/remote-control。
# init 按这里的规则给它打标签，所以这条必须存在，否则 socket 会是
# socket_device 标签，remote-control 反而访问不了自己的 socket。
/dev/socket/remote-control u:object_r:remote_control_socket:s0

# 开发期用的 socket（阶段 1 免 sepolicy 原型时会 bind 到这里）
# 生产环境不需要，可以删掉。
/data/local/tmp/remote-control\.sock u:object_r:remote_control_socket:s0
