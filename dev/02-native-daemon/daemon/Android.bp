// autod 的 AOSP 构建描述
//
// 放置位置：把 dev/02-native-daemon/ 整个目录拷进 AOSP 树的
//           frameworks/native/cmds/autod/（保持 daemon/ client/ 同级）
//
// 编译：
//   source build/envsetup.sh
//   lunch aosp_arm64-userdebug
//   m autod            # 默认：SurfaceFlinger 截图 + uinput 触控
//   m autod_binder     # 可选：IInputManager 触控（Android 12 上不可用）
//   m autod_stub       # 测试用：桩截图（不要装进产品镜像）
//
// 每个二进制只链一个截图后端 + 一个注入后端 —— 它们都定义同名工厂函数，
// 链在一起会重复符号。

// ---------------------------------------------------------------------------
// 共享配置
// ---------------------------------------------------------------------------
cc_defaults {
    name: "autod_defaults",

    srcs: [
        "main.cpp",
        "socket_server.cpp",
        "dispatch.cpp",        // 请求分发（可测试，从 main.cpp 抽出）
        "selftest.cpp",        // --selftest 部署自检
        "inject.cpp",          // 平台无关的手势逻辑
        "appops.cpp",          // 应用管理（pm/am/cmd/dumpsys）
        "subprocess.cpp",      // 无 shell 的子进程执行
        "fileops.cpp",         // 下载目录与文件操作
        "http_client.cpp",     // libcurl 运行时加载
        "service_state.cpp",   // 服务自身状态（API 的"控制自身"）
        "log_buffer.cpp",      // 进程内日志环形缓冲
        "http_server.cpp",
        "rest_api.cpp",
        "json_parser.cpp",
        "png_encoder.cpp",
        "keyboard.cpp",
        "clipops.cpp",
        "webui.cpp",
        "image_encoder.cpp",
        "frame_hub.cpp",
        "jpeg_encoder.cpp",
        "webp_encoder.cpp",
        "websocket.cpp",
        "config_file.cpp",
    ],

    // ⚠️ 必须排除静态库的符号导出，否则会与系统的 libc++.so 打架。
    //
    //    实测崩溃（启动即 SIGABRT）：
    //      #06 autod             std::__1::locale::use_facet(...)
    //      #07 /system/lib64/libc++.so  __stdinbuf<char>::imbue
    //      #08 /system/lib64/libc++.so  ios_base::Init::Init
    //      #09 /system/lib64/libc++.so  _GLOBAL__sub_I_iostream.cpp
    //
    //    原因：我们把 libc++ 静态链进来了，同时又加载了系统的 libc++.so
    //    （libgui/libbinder 依赖它）。系统库的 iostream 静态初始化调到了
    //    **我们二进制里那份** use_facet，而两边的 locale id 对不上，
    //    于是 use_facet 抛 bad_cast → 没人接 → terminate。
    //
    //    只要用 <sstream> 就会把 libc++ 的 locale 拉进来（appops.cpp 用了
    //    std::istringstream）。设备自带的 screencap 导出 0 个 locale 符号，
    //    所以它没事 —— 我们导出了 1 个，就中招了。
    //
    //    --exclude-libs,ALL 让静态库的符号不进动态符号表，
    //    系统库就会用自己那份，两边不再混。
    ldflags: ["-Wl,--exclude-libs,ALL"],

    shared_libs: [
        "libbase",
        "libbinder",
        "libcutils",
        "libgui",              // SurfaceComposerClient / SyncScreenCaptureListener
        // ⚠️ 这里**故意不链** libjnigraphics。
        //
        //    AndroidBitmap_compress 是 API 30 才有的符号，直接链接的话
        //    二进制在 Android 8~10 上**加载就会失败**
        //    （"cannot locate symbol AndroidBitmap_compress"），
        //    连运行时探测的机会都没有。
        //
        //    改成 dlopen + dlsym 之后，"这个函数不存在"变成一个
        //    可以处理的返回值 —— 见 image_encoder.cpp 的 ProbeJniGraphics。
        "liblog",
        "libui",               // GraphicBuffer / PixelFormat
        "libutils",
    ],

    header_libs: [
        "libgui_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",

        // 平台构建：能调系统服务、能接管 init socket。
        // 不要用 __ANDROID__ 判断 —— NDK 构建时它同样是定义的。
        "-DAUTOD_FULL_PLATFORM=1",
    ],

    cppflags: ["-std=c++20"],
    stl: "libc++_static",

    // 用平台私有 API，必须标记为非 NDK
    sdk_version: "",
}

// ---------------------------------------------------------------------------
// 默认目标
// ---------------------------------------------------------------------------
//
// 截图走 SurfaceFlinger::captureDisplay（和 AOSP 的 screencap 同源）。
// 触控走 /dev/uinput —— Android 12 上唯一可用的方式，因为 IInputManager
// 是 Java-only AIDL（见 docs/06-constraints.md 约束 1）。
//
// 代价：uinput 会创建一个可枚举的输入设备。
// 内置的 libwebp（编码器部分）。
//
// 为什么内置：设备上**没有** libwebp.so（实测 Android 12 就没有，
// Skia 里也没找到），而 AndroidBitmap_compress 是 API 30 才有的。
// 不内置的话 Android 8~10 完全没有 WebP。
//
// 和 libjpeg 的处理方式不同 —— 那个 dlopen 系统库就够了（VNDK 稳定
// ABI），WebP 没有系统库可用，只能把源码编进来。
//
// 只编编码器需要的三个目录：
//   enc    编码主流程
//   dsp    SIMD 加速（dsp.h 会按 __SSE2__/__ARM_NEON 自行选择）
//   utils  公共工具
// dec/ 的 .c 不需要，但 **src/dec 的头文件要留着** ——
// 编码器的头文件里 include 了它们。
cc_library_static {
    name: "libwebp_vendored",
    // ⚠️ 必须和消费者一致。
    //
    //    autod_defaults 里有 `sdk_version: ""`（标记为非 NDK 的平台构建）。
    //    这个库不写的话变体对不上，Soong 直接报
    //    "dependency ... missing variant"。
    sdk_version: "",
    // 纯 C 代码，不掺 C++ 运行时
    stl: "none",
    srcs: [
        "vendor/webp/src/enc/*.c",
        "vendor/webp/src/dsp/*.c",
        "vendor/webp/src/utils/*.c",
    ],
    local_include_dirs: ["vendor/webp"],
    // 这几个开关抄自 AOSP 的 external/webp（libwebp-encode）。
    // ⚠️ 不要自己加 -DWEBP_USE_SSE2 —— dsp.h 会按编译器的预定义宏
    //    自己判断，重复定义会报 macro redefined。
    cflags: [
        "-O2",
        "-DANDROID",
        "-DWEBP_SWAP_16BIT_CSP",
        "-DWEBP_USE_THREAD",
    ],
}

cc_binary {
    name: "autod",
    defaults: ["autod_defaults"],
    srcs: [
        "capture_surfaceflinger.cpp",
        "inject_uinput.cpp",
    ],

    // 自动安装到 /system/etc/init/autod.rc
    //
    // ⚠️ 路径里不能用 ".." —— Soong 会报
    //    "Path is outside directory: ../init/autod.rc"
    //    所以 autod.rc 必须与 Android.bp 同目录。
    init_rc: ["autod.rc"],

    vendor: false,
    proprietary: false,
}

// ---------------------------------------------------------------------------
// 可选目标：IInputManager 触控后端
// ---------------------------------------------------------------------------
//
// ⚠️ 在 Android 12 上加载会失败：IInputManager 没有 cpp backend。
//    保留是为了 Android 13+ 或自行给 AIDL 加 cpp backend 的场景。
//
// 优越之处：不创建额外的输入设备，不可被枚举。
cc_binary {
    name: "autod_binder",
    defaults: ["autod_defaults"],
    srcs: [
        "capture_surfaceflinger.cpp",
        "inject_binder.cpp",
    ],

    vendor: false,
    proprietary: false,
}

// ---------------------------------------------------------------------------
// 推荐目标：走 AOSP 官方的 virtual_touchpad 服务
// ---------------------------------------------------------------------------
//
// 触控不再自己写 uinput，而是调 AOSP 官方的 virtual_touchpad Binder 服务。
// 好处：autod **不需要 /dev/uinput 权限**（SELinux 大幅简化），
//       少维护 ~350 行 uinput 代码。
//
// 前置条件（两个都要做，否则跑不起来）：
//   1. 产品配置里加：PRODUCT_PACKAGES += virtual_touchpad
//      它默认不在 aosp_arm64 的产品包里（是 VR 专用）
//   2. sepolicy 按 sepolicy/autod.te 里「启用 vtp 后端」一节改
//
// 限制：官方实现只有 2 个触控槽位，做不了 3 指以上手势。
cc_binary {
    name: "autod_vtp",
    defaults: ["autod_defaults"],
    srcs: [
        "capture_surfaceflinger.cpp",
        "inject_vtp.cpp",
    ],

    shared_libs: [
        "libvirtualtouchpadclient",
    ],

    vendor: false,
    proprietary: false,
}

// ---------------------------------------------------------------------------
// 测试目标：桩截图后端
// ---------------------------------------------------------------------------
//
// 生成合成图像而不是真的抓屏。用于在没有显示设备的 CI 上冒烟测试，
// 或者验证帧通道（memfd + SCM_RIGHTS）。
//
// **不要编进产品镜像。** 名字带 _stub 就是为了避免误装。
cc_binary {
    name: "autod_stub",
    defaults: ["autod_defaults"],
    srcs: [
        "capture_stub.cpp",
        "inject_uinput.cpp",
    ],
    vendor: false,
    proprietary: false,
}

// ---------------------------------------------------------------------------
// 可选目标：screencap 截图后端
// ---------------------------------------------------------------------------
//
// 走 exec /system/bin/screencap，不依赖 libgui。
// 主要用途是 NDK 构建（见 tools/build-ndk.sh），那里完全不需要 AOSP 树。
//
// 在这里也提供一份是为了：想在 AOSP 树内编一个「不依赖 SurfaceFlinger 私有 API」
// 的版本时可以用。注意它会多链一个 libgui（来自 autod_defaults），无害但多余。
cc_binary {
    name: "autod_screencap",
    defaults: ["autod_defaults"],
    srcs: [
        "capture_screencap.cpp",
        "inject_uinput.cpp",
    ],
    vendor: false,
    proprietary: false,
}

// ---------------------------------------------------------------------------
// 备注
// ---------------------------------------------------------------------------
//
// 1. 三个后端各定义一个同名工厂（CreateInjectorBackend / Capture 的实现），
//    所以必须编成独立二进制。
//
// 2. shared_libs 里的 libgui 是平台私有库，需要完整 AOSP 树才能解析。
//    只想编一个模块的话，先 `m libgui` 把依赖备好。
//
// 3. 报 "unknown module libgui_headers" 时去掉 header_libs —— 较老版本
//    把 libgui 的头文件直接放在 libgui 的 export_include_dirs 里。
//
// 4. 需要编进 system 分区才能以 system/shell UID 运行并拿到所需权限。
//    userdebug/eng 版本可以 adb remount 后 push，eng 阶段不必每次刷机。
//
// 5. 主机侧的单元测试和集成测试见 ../tests/Makefile，
//    用 g++ 直接编译，不需要 AOSP：
//      cd ../tests && sudo make run
