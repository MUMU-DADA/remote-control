# remote-control 的 SELinux domain
#
# 安装位置：system/sepolicy/private/remote_control.te
#          （type 声明也可以放这里，因为只有 remote-control 自己用）
#
# =============================================================================
# 本文件的所有类型名和宏都已对照 android-12.0.0_r34 实际源码核实，不是猜的：
#
#   system/sepolicy/public/te_macros:162          init_daemon_domain 定义
#   system/sepolicy/public/device.te:25           gpu_device
#   system/sepolicy/public/device.te:54           uhid_device  ← 注意不是 uinput_device
#   system/sepolicy/private/file_contexts:189     /dev/uinput → uhid_device
#   system/core/rootdir/ueventd.rc:55             /dev/uinput 0660 uhid:uhid
#   system/sepolicy/public/virtual_touchpad.te    uinput 访问权限的现成模板 ★
#   system/sepolicy/private/surfaceflinger.te     GPU 访问 + binder 模式
#   system/sepolicy/public/file.te:510            自建 socket 的类型声明方式
#
# ★ 特别值得一提的是 virtual_touchpad —— AOSP 自带一个用 /dev/uinput
#   造虚拟触摸设备的域，注释写着 "Requires access to /dev/uinput to create
#   and feed the virtual device"。我们这个域做的事和它几乎一样，
#   所以 uinput 那几条规则直接照抄，不用自己摸索。
# =============================================================================

# -----------------------------------------------------------------------------
# 类型声明
# -----------------------------------------------------------------------------

type remote_control, domain;
type remote_control_exec, system_file_type, exec_type, file_type;

# 自建的 socket。coredomain_socket 属性让它能被 init 正确处理。
# 参考 public/file.te 里 statsdw_socket 的声明方式。
# ⚠️ 这里**故意不加 coredomain_socket**。
#
#    public/domain.te:757 有一条 neverallow：
#        neverallow { appdomain -coredomain } { coredomain_socket ... }:sock_file ...
#    而控制器应用（remote_control_controller）走 app_domain() 进了 appdomain，
#    它必须能连这个 socket —— 标成 coredomain_socket 就直接违反 neverallow，
#    编不过（实测报的就是它）。
#
#    —— 但也不能就留成普通 file_type：public/domain.te:773 还有一条
#        neverallow { coredomain -init -ueventd ... }
#                   { file_type dev_type -coredomain_socket -core_data_file_type
#                     -app_data_file_type -unlabeled }:sock_file ~{...};
#    即"coredomain 不许开 file_type 的 socket"，而 remote-control 是 coredomain。
#
#    两条 neverallow 夹下来，**同时满足的只有 app_data_file_type**：
#      · coredomain 规则把它列在排除项里 → 我们能开
#      · appdomain 规则禁的是 coredomain_socket / unlabeled / core_data_file_type，
#        app_data_file_type 不在其中 → 应用能连
#
#    这不是硬凑：AOSP 自己就是这么给"核心域拥有、应用要用"的东西打标签的
#    （public/file.te 里 bluetooth_data_file / nfc_data_file / radio_data_file
#     都带 app_data_file_type）。
#
#    POSIX 权限仍由 rc 的 0666 给，访问者由 remote_control_controller.te
#    里那两条 allow 精确限定（只放开这一个 socket，不是整个 domain）。
type remote_control_socket, file_type, data_file_type, app_data_file_type;

# 热替换通道用的两个类型（见下面的「载荷槽」一节）：
#   payload_exec  /data 里那份真正在跑的二进制
#   data_file     槽目录、指针、就绪标记、配置、日志
# ── 载荷槽的类型暂时**不声明** ──
#
# 计划里的 §5「热替换通道」想让服务执行 /data 里的载荷，实测被 AOSP 策略挡死了，
# 而且是**三条 neverallow 互相咬住**（每一条都单独试过）：
#
#   ① private/domain.te:315  只有 appdomain 能执行 /data 下的东西
#   ② public/domain.te:1186  只有 zygote/runas 那几家能转换**进** appdomain
#                            —— 所以 init 拉不起一个 appdomain 的壳
#   ③ public/domain.te:959   coredomain 只能对 system_file_type 有 entrypoint
#                            —— 所以 coredomain 的服务没法从 /data 的载荷进入
#
# 只让开一条没用：三条一起才构成"服务能起来"的完整链路。
# 全部绕开需要两处**架构上的让步**（壳跑在 shell 域 + 服务放弃 coredomain），
# 那是安全相关的取舍，得由人来定 —— 见 docs/09-deployment-and-update.md
# 末尾的「实施记录」。在定下来之前，这一节不声明任何类型。
#
# 服务现在直接从 /system 执行（remote_control_exec 是 system_file_type），
# §1/§3/§4 的自启与保活不受影响，那是本次需求的根因部分。

# ⚠️ 这里**故意不加 data_file_type**。
#
#    public/domain.te:812 有一条 neverallow：
#        neverallow { coredomain -appdomain ... }
#                   { data_file_type -core_data_file_type -app_data_file_type }
#                   :file_class_set ~{ append getattr ioctl read write map };
#    意思是"coredomain 不许广泛访问 data_file_type"。而 remote-control 正是
#    coredomain（平台守护进程，要调 SurfaceFlinger 和 binder），
#    它的槽目录又要读写 —— 一旦把类型标成 data_file_type，
#    上面那条 allow 立刻就违反 neverallow，编不过（实测报的就是它）。
#
#    解法是**同时**带 app_data_file_type —— 那条 neverallow 把
#    app_data_file_type 列在排除项里，带上它就不再违规；
#    而 sepolicy_tests 要的 data_file_type 也还在。
# sepolicy_tests 对 /data 下的类型有两条硬要求（实测报出来的原文）：
#   · 必须关联 core_data_file_type  —— "The following types on /data/ must be
#     associated with the core_data_file_type attribute"
#   · **不能**关联 app_data_file_type —— "must not be associated with the
#     app_data_file_type attribute"
# 两条一起才收敛到下面这一行。
type remote_control_data_file, file_type, data_file_type, core_data_file_type;

typeattribute remote_control coredomain;

# 由 init 启动并做域转换。
# 宏展开就是 domain_auto_trans(init, remote_control_exec, remote-control)
init_daemon_domain(remote_control)

# -----------------------------------------------------------------------------
# Binder 基础设施
# -----------------------------------------------------------------------------

binder_use(remote_control)

# HTTP/JSON API 要监听 TCP。
#
# ⚠️ 光加 `allow ... self:tcp_socket { bind }` 不够：绑定端口还要
#    name_bind 权限，实测报
#        avc: denied { name_bind } ... src=8088 tcontext=u:object_r:port:s0
#    AOSP 把端口标成 port_type / node 之类，逐个 portcon 太脆 ——
#    而我们的端口是**配置项**（/data/misc/remote-control/remote-control.conf
#    里可以改），写死一个 portcon 等于把"改端口"变成"改 sepolicy 重编镜像"。
#
#    正解是 net_domain()：public/net.te 里有
#        allow {netdomain -ephemeral_app} port_type:tcp_socket name_bind;
#    进了 netdomain 属性就能绑任意端口，同时拿到标准的网络权限。
net_domain(remote_control)

# -----------------------------------------------------------------------------
# 截图：调 SurfaceFlinger
# -----------------------------------------------------------------------------
#
# 对照 private/surfaceflinger.te：它自己 rw_file_perms 访问 gpu_device；
# 我们作为客户端只需要能映射它给的 GraphicBuffer。

# ── 当图形 HAL 的客户端 ──────────────────────────────────────────────────
#
# ⚠️ **这才是抓帧真正缺的那一块。**
#
# 抓帧要经过 gralloc / graphics allocator HAL：申请缓冲区、拿 fd、
# 读 hwservicemanager 的属性去找服务。这些权限平时是**白来的** ——
# `screencap` 以 shell 身份跑，而 shell 早就被声明成各种 HAL 的客户端了；
# 我们自己的域没有，于是漏了一大片细碎的规则。
#
# 缺了它的表现极难查：抓帧线程在跑、订阅登记正常、/params 显示
# activeFps/subscribers 都正常，唯独 **frames=0** —— CaptureOnce
# **卡在** HAL 调用里出不来（不是失败，所以连错误都不打），页面全黑。
# dmesg 里先是 `fd use` 被拒，补掉之后又冒出
#     avc: denied { read } ... hwservicemanager_prop
# 一条条补是补不完的 —— 正确做法是声明成 HAL 客户端，让宏把整套规则带进来。
hal_client_domain(remote_control, hal_graphics_allocator)
hal_client_domain(remote_control, hal_graphics_composer)

# ── 和 system_server 打交道（pm / am / cmd / settings / content 全靠这条）──
#
# ⚠️ `/system/bin/pm` 的真实内容是：
#        #!/system/bin/sh
#        cmd package "$@"
#    它走 **binder** 去 system_server 找 package 服务，不是起 Java VM
#    （我一开始误判成缺 pm.jar，其实那个脚本根本不用 jar）。
#
#    没有这些权限时 `cmd` **静默返回退出码 20**（服务找不到/无权限），
#    而 service_manager 的拒绝在 AOSP 里默认是 **dontaudit** 的 ——
#    dmesg 里什么都看不到。这就是为什么这一条查了那么多轮：
#    现象像 Java 层问题，实际是 binder 授权缺失，且**不留痕迹**。
#
#    app_api_service 是 AOSP 给"应用可见系统服务"的分组属性。
binder_call(remote_control, system_server)
allow remote_control servicemanager:service_manager find;
allow remote_control app_api_service:service_manager find;

binder_call(remote_control, surfaceflinger)
# 抓帧是**回调**：SurfaceFlinger 拿到我们的 BufferQueue 之后要反向调回来。
# 只给单向的话实测报
#     avc: denied { call } for comm="surfaceflinger"
#         scontext=u:r:surfaceflinger:s0 tcontext=u:r:remote_control:s0 tclass=binder
binder_call(surfaceflinger, remote_control)
allow remote_control surfaceflinger_service:service_manager find;

# GraphicBuffer 底层是 gralloc 分配的 dma-buf，需要访问 GPU 设备节点
allow remote_control gpu_device:chr_file rw_file_perms;

# -----------------------------------------------------------------------------
# 触控：写 /dev/uinput
# -----------------------------------------------------------------------------
#
# 直接照抄 public/virtual_touchpad.te 的同名规则。
#
# ⚠️ 类型是 uhid_device，不是 uinput_device ——
#    /dev/uinput 和 /dev/uhid 共用同一个标签。
#    POSIX 权限是 0660 uhid:uhid，所以进程的 UID/GID 也要对
#    （init.rc 里用 `user system` + `group system uhid`）。

allow remote_control uhid_device:chr_file { w_file_perms ioctl };

# -----------------------------------------------------------------------------
# 对外 socket：AF_UNIX SOCK_SEQPACKET
# -----------------------------------------------------------------------------
#
# ⚠️ SELinux 里**没有** unix_seqpacket_socket 这个类 ——
#    内核把 SOCK_SEQPACKET 映射到 unix_stream_socket，别去找 seqpacket 类。
#
# socket 由 init 创建（remote-control.rc 里的 `socket remote-control seqpacket 0660 system system`），
# 所以 init 负责 create/bind/listen，remote-control 只负责 accept/读写。

# ⚠️ 这里原来是 `remote_control_socket:{ sock_file create setattr unlink };` ——
#    **语法错误**。`X:{ ... }` 在 SELinux 里是"**类**的列表"
#    （见 AOSP 自己写的 `self:{ socket vsock_socket } create;`），
#    把权限写进那个花括号里 checkpolicy 直接报 syntax error。
#    单个类 + 若干权限的正确写法是 `X:类 { 权限... }`。
#
#    这条一直没被发现，是因为这份策略**从来没被编译过**
#    （接入脚本当时还按连字符找文件，见 docs/09-deployment-and-update.md §4.2）。
allow init remote_control_socket:sock_file { create setattr unlink };

allow remote_control remote_control_socket:sock_file rw_file_perms;
allow remote_control self:unix_stream_socket { create bind listen accept read write getattr shutdown };

# 客户端要连这个 socket。
# 如果调用方是 app，把下面两行的注释去掉并把 untrusted_app 换成实际 domain；
# 如果调用方是 adb shell，用 shell；如果是自己的 native 进程，用它的 domain。
#
# allow untrusted_app remote_control_socket:sock_file write;
# allow untrusted_app remote-control:unix_stream_socket connectto;

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------

allow remote_control self:capability { sys_admin };
allow remote_control remote_control_exec:file { read open execute execute_no_trans map };

# =============================================================================
# 载荷槽：/data/misc/remote-control（热替换通道）
# =============================================================================
#
# 启动壳从 /data 里取真正的二进制并 exec —— 这样"服务起来之后还能换版本"
# 才成立（init 不重读 rc，/system 又没有持久写入通道；
# 见 docs/09-deployment-and-update.md §5）。
#
# ⚠️ 这是整套方案**唯一的安全依据**：
#   · 更新源必须放 /data/misc/remote-control，**绝不能放 /sdcard** ——
#     那是共享存储，任何应用都能写，等于把可执行载荷和执行权一起交出去。
#   · 壳在 exec 之前核对 sha256（槽目录名就是期望的哈希）。
#
# 壳与服务要能读写槽目录：指针（current / last-good）、就绪标记、配置、日志
allow remote_control remote_control_data_file:dir {
    open read search write add_name remove_name create getattr setattr
};
# ⚠️ append 不能漏 —— 日志是**追加**写的。少了它实测报
#     avc: denied { append } ... tcontext=u:object_r:remote_control_data_file:s0
#    而写不出日志时进程直接退出，init 每 5 秒拉一次、崩一次。
allow remote_control remote_control_data_file:file {
    create read write append open getattr unlink rename setattr map
};

# 服务自己 bind 的 Unix socket（放在自己的目录里，见 remote-control.rc）。
#
# 不会撞 domain.te:773 那条"coredomain 不许开 file_type 的 socket"：
# remote_control_data_file 带 core_data_file_type，正列在那条的排除项里。
allow remote_control remote_control_data_file:sock_file {
    create read write open getattr unlink setattr
};

# 抓帧的图形缓冲区是**跨域传 fd** 的：SurfaceFlinger / gralloc 把 buffer 的
# fd 通过 binder 递给我们，内核要检查我们对那个 fd 的 use 权限。
#
# 少了这条实测的表现极具迷惑性：服务 running、订阅登记正常、编码器在初始化、
# /params 显示 activeFps=60 subscribers=1 —— 但 **frames=0**，
# 抓帧线程卡在 CaptureOnce 里出不来，一帧都不发，页面全黑。
# dmesg 里才看得到：
#     avc: denied { use } ... scontext=u:r:remote_control:s0
#         tcontext=u:r:hal_graphics_allocator_default:s0 tclass=fd
# ⚠️ 这一行**去掉了**：`hal_graphics_allocator_default` 是 vendor 侧的实现类型，
#    策略编在 system_ext 分区时看不见它（报 unknown type）。
#    上面那条 hal_client_domain() 宏用的是 **attribute**（可见性规则不同），
#    由它来提供 fd 权限。实测验证：去掉之后抓帧是否仍然正常。
# allow remote_control hal_graphics_allocator_default:fd use;
allow remote_control surfaceflinger:fd use;
allow remote_control gpu_device:fd use;

# ⚠️⚠️ **`svc` / `pm` / `am` 都是 shell 脚本**（不是二进制！），跑它们要
#      exec `/system/bin/sh`。少了这条，一整类功能**静默失效**：
#       · 电源重启/关机（svc power reboot）
#       · 装应用 / 卸载（pm install|uninstall）
#       · 启动应用（am start）
#     接口全都返回 ok:true，设备却什么都没发生 —— 因为 exec 在子进程里
#     失败，而父进程早就把成功应答发出去了。
#     实测 denial：
#         avc: denied { execute } for comm="remote-control" name="sh"
#             tcontext=u:object_r:shell_exec:s0
#     shell_exec 是 system_file_type，coredomain 本来就有资格执行 ——
#     只是没人写过这条 allow。服务本来就是设计来跑这些命令的，加上。
allow remote_control shell_exec:file {
    read open getattr map execute execute_no_trans
};

# ── 让 pm / am / svc 的子进程跑在 shell 域里 ─────────────────────────────
#
# ⚠️ 这一条是**整类问题的正解**，别再去一条条补 allow。
#
# `pm` / `am` / `svc` 都是 shell 脚本，脚本由 `/system/bin/sh` 解释执行；
# 而它们真正干的事是 `app_process` 起一个 Java VM 去调系统服务 ——
# 那等于要求我们的域具备一整套"普通 shell 环境"的权限：
#
#     device_config_runtime_native_prop / odsign_prop 之类的属性读
#     /mnt/user/0、fuse 之类的路径遍历
#     /data/local/tmp、各种设备节点……
#
# 一条条补就是打地鼠（实测补完一批又冒一批）。而且其中有些属性是
# **平台私有类型**，设备树的策略编在 vendor 分区，压根写不了。
#
# 正解是让解释器 exec 时**转入 shell 域** —— 也就是 adb shell 走的那条路。
#   · 没有 neverallow 挡（public/domain.te:1186 对 shell 是 -shell 豁免）
#   · 安全上也不越界：服务本来就以 **shell UID** 运行，子进程拿 shell 域
#     只是让 SELinux 身份跟上 POSIX 身份，与它的职责一致
#   · 服务**本体**仍然是 remote_control 专属域，只有它主动 exec 的那些
#     命令行工具落在 shell 里
#
# 副作用：`sh -c "..."` 也会跑在 shell 域 —— 这正是"服务能跑 shell 命令"
# 的语义，符合它的功能定位（文件管理、应用管理都依赖这一点）。
# ⚠️ 这里本来想用 domain_auto_trans(remote_control, shell_exec, shell)
#    一劳永逸 —— 实测**不行**：public/domain.te:1179 规定只有
#    adbd / init / runas / zygote 能转换进 shell 域。
#    所以还是得显式补权限（下面那些 get_prop 与路径权限）。

# ── 跑 Java 命令行工具（pm / am / svc 都靠 app_process）──────────────────
#
# 补齐 exec sh + zygote_exec 之后，app_process 能起来了（denial 的 comm
# 从 remote-control 变成 app_process），但启动 Java VM 还要读几个属性：
#     avc: denied { read } ... device_config_runtime_native_boot_prop
#     avc: denied { read } ... odsign_prop
# 这两类属性 AOSP 本来是给"会跑 app_process 的域"的，我们的域得自己声明。
# ⚠️ 必须走 get_prop() 宏，**不能**自己写 r_file_perms。
#
# private/property.te 里有 neverallow domain property_type:file { ioctl lock }，
# 它自己的注释就写着：「多半是策略直接用了 r_file_perms 而不是 get_prop() 宏」。
# 属性访问在 AOSP 是一套宏 + neverallow 强制的白名单机制，
# 自己写 allow 一定撞上。实测报的就是这条 + odsign_prop 的 unknown type
# （私有属性类型在设备树里看不见，宏会替你处理）。
# ⚠️⚠️ **这才是 app_process 起不来的真正原因**（追了很多轮）：
#
#     avc: denied { lock } for comm="app_process"
#         path="/system/framework/x86_64/boot-ext.art"
#         tcontext=u:object_r:system_file:s0
#
#    Java VM 启动时要给 ART 引导镜像（boot*.art / *.oat）**加锁**，
#    而常规的 system_file 权限集（read/open/getattr/execute…）里**没有 lock**，
#    所以既不是"读不到"也不是"执行不了"，而是这一条冷门权限缺了。
#
#    排查难点：它和 pm/am/属性全都不沾边，报错也只说"退出码 20"、
#    "bash arg: ..."，看起来像 Java 层的事，实际卡在内核权限上。
#    AOSP 里 netd 和 dex2oat 也是这么拿的（public/netd.te:41、private/dex2oat.te:21），
#    唯一的 neverallow 只针对 all_untrusted_apps，与我们无关。
allow remote_control system_file:file lock;
allow remote_control apex_module_data_file:file lock;

get_prop(remote_control, device_config_runtime_native_boot_prop)
# 这两个是**平台私有**属性类型。策略编在 system_ext 分区时才看得见
# （vendor 分区会报 unknown type）—— 这正是本次把落点从 BOARD_SEPOLICY_DIRS
# 换到 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS 的原因。
# app_process 起 Java VM 要读它们，读不到就起不来（pm/am/剪贴板全废）。
get_prop(remote_control, device_config_runtime_native_prop)
get_prop(remote_control, odsign_prop)

# ⚠️ `device_config_runtime_native_prop` 与 `odsign_prop` **写不了**：
#    它们是平台私有属性类型，而本策略编进 **vendor** 分区，看不见平台私有类型。
#    要靠它们就得把策略挪到 system_ext —— 但那会丢掉 vendor 侧的 HAL 类型
#    （抓帧要用），一个分区拿不到两边。见 BoardConfig 那段。
#    影响：app_process 起 Java VM 时这两个属性读不到。
#    目前先接受：应用管理可能不完整，抓帧（立身之本）优先。

# ⚠️ odsign_prop 这里**不能写**：它是**平台私有**属性类型
#    （定义在 system/sepolicy/private/），而设备树的策略编进 **vendor** 分区，
#    看不到平台私有类型 —— 实测报 `unknown type odsign_prop`。
#    属性本来就有分区边界，这是设计如此，不是缺什么。
#    app_process 那条 read 若确实致命，再说 —— 目前它只是噪音。

# ── /sdcard（文件管理功能要用）─────────────────────────────────────────────
#
# 实测现象：文件管理「列出 /sdcard」返回 **0 项**，dmesg 里是
#     avc: denied { search } for comm="remote-control" name="0"
#         tcontext=u:object_r:mnt_user_file:s0 tclass=dir
# 即过不去 /mnt/user/0 这一层。
#
# AOSP 给 appdomain 的就是这两条（public/app.te:260-261），照抄。
# /sdcard 上的文件本身是 media_rw_data_file（由 FUSE 提供）。
#
# ⚠️ 计划 §4.4 当时写「user shell → /sdcard 可读写」，那是在 **permissive**
#    下测的；Enforcing 下这一层是 FUSE + sepolicy 双重把关，POSIX 身份对了
#    也进不去。这类结论都得在 Enforcing 下重测。
allow remote_control mnt_user_file:dir r_dir_perms;
allow remote_control mnt_user_file:lnk_file r_file_perms;
# ⚠️ fuse 那一层也要过：补了 mnt_user_file + media_rw_data_file 之后
#    /sdcard 仍然列不出东西，denial 换成了
#        avc: denied { search } ... dev="fuse" tcontext=u:object_r:fuse:s0
#    /sdcard 是 FUSE 提供的，挂载点本身是 fuse 类型，得单独给。
allow remote_control fuse:dir { search getattr open read };
allow remote_control fuse:file { read open getattr };
allow remote_control media_rw_data_file:dir { open read search getattr };
allow remote_control media_rw_data_file:file { open read getattr };

# svc / pm / am 是 shell 脚本，脚本里调的是 `app_process64`（Java 层），
# 所以还要能 exec zygote_exec。AOSP 给 shell 的就是这一条
# （public/shell.te:64 `allow shell zygote_exec:file rx_file_perms;`），
# 我们照抄 —— 没有 neverallow 挡。
allow remote_control zygote_exec:file rx_file_perms;

# 应用管理（/api/v1/app* 那些接口）要跑 dumpsys。
allow remote_control system_file:file {
    read open getattr map execute execute_no_trans
};

# JSON 响应是先写进 memfd 再发出去的 —— 少了这条，响应根本拼不出来，
# 表现为**服务在跑、端口在听、连接却永远不返回**（实测 HTTP 000）。
# memfd 落在通用 tmpfs 类型上（我们的域没有 tmpfs 的 type_transition）。
allow remote_control tmpfs:file { read write open getattr map };

# HTTP / JSON API 的 TCP 监听。
#
# 少了这条实测报 avc: denied { create } ... tclass=tcp_socket，
# 服务起不来（HTTP 是主要入口之一）。
allow remote_control self:tcp_socket {
    create bind listen accept read write getattr setopt shutdown
};

# 壳要 fork 载荷、等它退出（sigchld）、起不来时杀掉它（signal）
allow remote_control self:process { fork sigchld };
allow remote_control self:process signal;

# -----------------------------------------------------------------------------
# 第一阶段：先用 permissive 定位
# -----------------------------------------------------------------------------
#
# 把下面这行放开，init 会打印所有「本来会被拒绝」的操作而不真的拦，
# 可以一次性收集全部 avc 报错，然后逐条收 allow。
#
# 正确工作流：
#   1. 放开 permissive
#   2. adb shell dmesg | grep 'avc:.*remote-control' > avc.log
#   3. ./prebuilts/build-tools/linux-x86/bin/audit2allow -i avc.log
#   4. 把生成的 allow 逐条加进来
#   5. 注释掉 permissive，重编
#
# ⚠️ 进生产前必须删掉 —— permissive domain 会导致 CTS 失败。
#
# permissive remote-control;

# -----------------------------------------------------------------------------
# 配套改动清单（别漏）
# -----------------------------------------------------------------------------
#
# 1. system/sepolicy/private/file_contexts 追加：
#       /system/bin/remote-control              u:object_r:remote_control_exec:s0
#       /dev/socket/remote-control              u:object_r:remote_control_socket:s0
#
# 2. remote-control.rc（已随 Android.bp 的 init_rc 自动装到 /system/etc/init/）：
#       service remote-control /system/bin/remote-control --init-socket remote-control
#           class core
#           user system
#           group system uhid          ← uhid 组是 /dev/uinput 的属组，别漏
#           seclabel u:r:remote-control:s0
#           socket remote-control seqpacket 0660 system system
#
# 3. 确认 init 能访问 remote_control_exec：
#       init 通过 init_daemon_domain 宏拿到执行权，通常无需额外规则。

# =============================================================================
# 变体：启用 remote_control_vtp（走 AOSP 官方 virtual_touchpad 服务）
# =============================================================================
#
# 如果 remote-control 用 inject_vtp.cpp（而不是 inject_uinput.cpp），
# 触控那部分权限可以整段替换掉 —— remote-control 不再碰 /dev/uinput。
#
# ── 删掉这两条 ──
#   allow remote-control uhid_device:chr_file { w_file_perms ioctl };
#   （remote-control.rc 里的 `group system uhid` 也不再需要，但留着无害）
#
# ── 换成这两条 ──
#   binder_call(remote-control, virtual_touchpad)
#   allow remote-control virtual_touchpad_service:service_manager find;
#
# 对比：
#   自己写 uinput  → 需要 uhid 组 + uhid_device 访问权
#   走官方服务     → 只需要能 find 到服务，权限面小得多
#
# ── 另外要做的事 ──
#   PRODUCT_PACKAGES += virtual_touchpad
#
#   virtual_touchpad 默认**不**编进 aosp_arm64 产品包（它是 VR 专用）。
#   不加这一行的话，remote_control_vtp 启动后会 attach 失败：
#     "attach() 失败 (status=-2) —— 确认 virtual_touchpad 服务在跑"
#
# ── 已知限制 ──
#   官方实现只有 2 个触控槽位（VirtualTouchpadEvdev::kTouchpads = 2），
#   做不了 3 指以上手势。单指/双指（点击、滑动、缩放）都够用。

# =============================================================================
# UID 选择：system(1000) 还是 shell(2000)
# =============================================================================
#
# remote-control 需要同时满足三件事，而它们的来源不同：
#
#   1. 能调 SurfaceFlinger::captureDisplay（截图）
#   2. 能写 /dev/uinput（触控）
#   3. 有 INJECT_EVENTS（如果将来启用 binder 触控后端）
#
# ── 1. 截图的权限判定（已对照源码核实）──
#
# frameworks/native/services/surfaceflinger/SurfaceFlinger.cpp:
#
#   static status_t validateScreenshotPermissions(const CaptureArgs& captureArgs) {
#       const int uid = ipc->getCallingUid();
#       if (uid == AID_GRAPHICS || PermissionCache::checkPermission(sReadFramebuffer, pid, uid)) {
#           return OK;
#       }
#       if (captureArgs.uid == uid) {   // 只截自己
#           return OK;
#       }
#       ALOGE("Permission Denial: can't take screenshot pid=%d, uid=%d", pid, uid);
#       return PERMISSION_DENIED;
#   }
#
# 而 SurfaceFlinger::captureDisplay() 第一件事就是调它，失败直接返回。
#
# ⚠️ 关键坑：`uid == AID_GRAPHICS` 比的是 **UID**，不是 GID。
#    AID_GRAPHICS = 1003（见 system/core/libcutils/include/private/
#    android_filesystem_config.h）。所以"把进程加进 graphics 组"
#    **并不能**满足这个条件 —— 它要的是调用方的 UID 就是 1003。
#
#    第二条路是 READ_FRAME_BUFFER 这个权限。它的保护级别是
#    `signature|recents`（frameworks/base/core/res/AndroidManifest.xml:4345）。
#
#    已知持有它的：
#      AID_SHELL(2000) —— com.android.shell 在 AndroidManifest.xml:178 里声明了它。
#                         `adb exec-out screencap` 能工作就是这个原因，**已确证**。
#      AID_SYSTEM(1000) —— 待实测。system_server 自己截屏走的是内部路径，
#                         不能直接推断外部进程以 1000 调用也能通过。
#
# ── 2. /dev/uinput ──
#
#   SELinux：allow <domain> uhid_device:chr_file { w_file_perms ioctl }
#   POSIX  ：/dev/uinput 是 0660 uhid:uhid（system/core/rootdir/ueventd.rc:55）
#            → 进程必须在 uhid 组里
#   shell.te 里也有 `allow shell uhid_device:chr_file rw_file_perms`
#
# ── 3. INJECT_EVENTS ──
#
#   shell 和 system 都持有（`adb shell input` 就是 shell 身份）。
#
# ── 结论与实测方法 ──
#
# 两个 UID 都能满足 2 和 3；分歧只在 1。
#
#   先按 `user system` + `group system uhid graphics` 试。
#   推上去第一步就跑：
#
#       remote-control --selftest
#
#   它会做一次真实抓帧。[2] 截图一节若报
#
#       Capture::Init 失败 / 抓帧失败: ... PERMISSION_DENIED
#
#   就把 remote-control.rc 改成：
#
#       user shell
#       group shell uhid graphics
#
#   并让客户端也以 shell 身份运行（或把 socket 权限放宽到对应组）。
#
# 不要把这条留成"以后再说" —— 它决定了整个服务能不能用，
# 而且是 30 秒就能测出来的事。
