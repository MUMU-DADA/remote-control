-        std::copy(seed_vector.begin(), seed_vector.end(), seed);
-    }
-    ED25519_keypair_from_seed(pubKey.data(), privKey.data(), seed);
+PureSoftRemoteProvisioningContext::GenerateBcc(bool /* testMode */) const {
+    static const uint8_t kPriv[ED25519_PRIVATE_KEY_LEN] = {0};
+    static const uint8_t kPub[ED25519_PUBLIC_KEY_LEN] = {0};
+
+    std::vector<uint8_t> privKey(kPriv, kPriv + sizeof(kPriv));
+    std::vector<uint8_t> pubKey(kPub, kPub + sizeof(kPub));
 
     auto coseKey = cppbor::Map()
