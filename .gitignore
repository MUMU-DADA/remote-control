# ============================================================================
# AutoSnapshotAndroid
# ============================================================================

# --- AOSP 源码树 ---
# ~45GB（+ .repo ~30GB），由 `repo` 独立管理着 314 个 git 项目，
# 不属于本仓库；本仓库只跟踪 dev/ docs/ tools/ 等项目本体内容。
/aosp/

# --- 数据盘根目录的文件系统元数据 ---
/lost+found/

# --- 编译产物 ---
# dev/02-native-daemon/tests 下 make 出来的测试程序（make clean 会删掉）
#
# ⚠️ 用模式而不是逐个列文件名。
#    原来是 /dev/**/tests/test_inject_uinput 这样一行一个 —— 加一个测试
#    就得记得加一行，而没人会记得。实测漏了 4 个（test_appops /
#    test_json / test_keyboard / test_websocket），一共 3.3 MB 的 ELF
#    被提交进了仓库。
#
#    同名 .cpp/.h 是源码，用 ! 排除掉。
/dev/**/tests/test_*
!/dev/**/tests/test_*.cpp
!/dev/**/tests/test_*.h
!/dev/**/tests/test_*.md
*.o
*.a
*.d
*.so
*.so.*

# 主机侧构建产物（tools/build-autod.sh、tests/Makefile 编出来的 ELF，不是源码）
# 对应源码是 .c/.cpp，文件名不同，不会被误伤
/dev/02-native-daemon/autod-host
/dev/02-native-daemon/autodctl-host
/dev/**/tests/fake_screencap

# --- dev/04-emulator：运行期文件与下载物，都不入库 ---
# 开发机侧：userdata 覆盖层、模拟器控制台日志、冒烟测试截图
/dev/04-emulator/linux-arm64/.run/
# Windows 侧：下载的 SDK emulator、从开发机拉来的镜像（数 GB）、userdata 覆盖层
/dev/04-emulator/windows-arm64/sdk/
/dev/04-emulator/windows-arm64/images/
/dev/04-emulator/windows-arm64/data/

# --- AOSP 构建输出 ---
# 正常情况下会落在 aosp/out/
# 构建临时目录（TMPDIR 指过来用的，因为 /tmp 是 tmpfs 且经常被占满）
/.tmp/（已被上面的 /aosp/ 覆盖），这里只是留个记号
out/

# 说明：.vscode/settings.json 是**要**入库的，它记录了"只监听本项目、
#       不扫 aosp/"的 VSCode 配置，不要忽略。
