# ============================================================================
# AutoSnapshotAndroid
# ============================================================================

# --- AOSP 源码树 ---
# ~45GB（+ .repo ~30GB），由 `repo` 独立管理着 314 个 git 项目，
# 不属于本仓库；本仓库只跟踪 dev/ docs/ tools/ 等项目本体内容。
/aosp/

# --- 数据盘根目录的文件系统元数据 ---
/lost+found/

# --- 编译产物 ---
# dev/02-native-daemon/tests 下 make 出来的测试程序（make clean 会删掉）
#
# ⚠️ 用模式而不是逐个列文件名。
#    原来是 /dev/**/tests/test_inject_uinput 这样一行一个 —— 加一个测试
#    就得记得加一行，而没人会记得。实测漏了 4 个（test_appops /
#    test_json / test_keyboard / test_websocket），一共 3.3 MB 的 ELF
#    被提交进了仓库。
#
#    同名 .cpp/.h 是源码，用 ! 排除掉。
/dev/**/tests/test_*
!/dev/**/tests/test_*.cpp
!/dev/**/tests/test_*.h
!/dev/**/tests/test_*.md
*.o
*.a
*.d
*.so
*.so.*

# 主机侧构建产物（tools/build-remote-control.sh、tests/Makefile 编出来的 ELF，不是源码）
# 对应源码是 .c/.cpp，文件名不同，不会被误伤
/dev/02-native-daemon/remote-control-host
/dev/02-native-daemon/rcctl-host
/dev/**/tests/fake_screencap

# --- dev/04-x64-android：x86_64+ARM64 桥 ROM 项目 ---
# 细则在该目录自己的 .gitignore 里（就近维护）；这里只列**最容易被误提交的大件**，
# 方便一眼看出"这个目录为什么不能整目录 git add"。
#   .run/        模拟器 datadir、下载的模拟器包（~400 MB）、打包锁
#   artifacts/   ROM 产物（system-qemu.img 等，5.7 GB）
#   payload/system/  翻译层（Google 专有二进制，23 MB，可用 fetch-payload.sh 重建）
/dev/04-x64-android/.run/
/dev/04-x64-android/artifacts/
/dev/04-x64-android/payload/system/
/dev/04-x64-android/windows/sdk/
/dev/04-x64-android/windows/images/
/dev/04-x64-android/windows/data/

# --- 构建产物：脚本能重新生成，不入库 ---
# dev/05-controller-app/build-apk.sh 的产出（含 debug.keystore —— 缺了脚本会自己 keytool 生成）
/dev/05-controller-app/build/
/dev/05-controller-app/debug.keystore
# dev/02-native-daemon/tools/cliptool/build.sh 的产出
# cliptool 的构建目录整体忽略，但**产物 jar 要入库** ——
# ROM 用 PRODUCT_COPY_FILES 直接拷它（见产品 .mk）。不入库的话，
# 全新检出编 ROM 会因为找不到这个文件而失败。
/dev/02-native-daemon/tools/cliptool/build/*
!/dev/02-native-daemon/tools/cliptool/build/cliptool.jar

# tests/Makefile 的中间产物：build/webp 下的 .o，以及 build/.counts
# （后者是 `make run` 用来核对 README 检查数的临时计数文件）
/dev/02-native-daemon/tests/build/

# Python 字节码缓存（tools/*.py 被 import 或 py_compile 时生成）
__pycache__/

# --- AOSP 构建输出 ---
# 正常情况下会落在 aosp/out/
out/

# 构建临时目录：TMPDIR 指过来用的。
# 因为 /tmp 是 tmpfs（16G，RAM 支撑），并行任务一多就满，
# 而构建报的 "No space left on device" 会让人去查项目盘（那是空的）。
/.tmp/

# 说明：.vscode/settings.json 是**要**入库的，它记录了"只监听本项目、
#       不扫 aosp/"的 VSCode 配置，不要忽略。
